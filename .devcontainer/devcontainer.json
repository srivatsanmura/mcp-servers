{
  "name": "Python uv Project",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    // Automatically installs the latest version of uv into the container
    "ghcr.io/devcontainers-extra/features/uv:1": {},
    //Add git-lfs automatically
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },

    "containerEnv": {
    "UV_LINK_MODE": "copy"
  },

  "customizations": {
    "vscode": {
      "settings": {
        // Tells VS Code to look inside the project virtual env for packages
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.analysis.extraPaths": ["${workspaceFolder}/.venv/lib/python3.12/site-packages"]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff" // Fast Rust-based linter/formatter (made by creators of uv)
      ]
    }
  },

  // Automatically syncs dependencies and creates the .venv upon creation
  "postCreateCommand": "uv sync"
}